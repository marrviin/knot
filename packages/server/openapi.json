{
  "openapi": "3.0.3",
  "info": {
    "title": "Knot memory service",
    "description": "记忆服务：facts 增删改查 + 语义搜索 + 项目注册表",
    "version": "0.2.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "ready"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "embedSignature": {
                      "type": "string"
                    },
                    "embedModel": {
                      "type": "string"
                    },
                    "notice": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "operationId": "ingestFacts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId",
                  "raw"
                ],
                "properties": {
                  "projectId": {
                    "type": "string"
                  },
                  "raw": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "properties": {
                      "agent": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      }
                    }
                  },
                  "preferExisting": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report",
                    "facts"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "added",
                        "updated",
                        "deleted"
                      ],
                      "properties": {
                        "added": {
                          "type": "number"
                        },
                        "updated": {
                          "type": "number"
                        },
                        "deleted": {
                          "type": "number"
                        },
                        "notice": {
                          "type": "string"
                        }
                      }
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "memory"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "memory": {
                            "type": "string"
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "createdAt": {
                            "type": "number",
                            "nullable": true
                          },
                          "updatedAt": {
                            "type": "number",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/facts": {
      "post": {
        "operationId": "addFact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId",
                  "content"
                ],
                "properties": {
                  "projectId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report",
                    "facts"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "added",
                        "updated",
                        "deleted"
                      ],
                      "properties": {
                        "added": {
                          "type": "number"
                        },
                        "updated": {
                          "type": "number"
                        },
                        "deleted": {
                          "type": "number"
                        },
                        "notice": {
                          "type": "string"
                        }
                      }
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "memory"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "memory": {
                            "type": "string"
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "createdAt": {
                            "type": "number",
                            "nullable": true
                          },
                          "updatedAt": {
                            "type": "number",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/facts/{id}": {
      "put": {
        "operationId": "updateFact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFact",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/facts": {
      "get": {
        "operationId": "listFacts",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "projectId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "facts"
