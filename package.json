{
  "name": "knot",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/kill-port.mjs 5173 && pnpm rebuild:electron >/dev/null 2>&1; pnpm build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "pnpm build:electron && vite build",
    "build:electron": "rm -rf dist-electron && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:better-sqlite3 --external:mem0ai --external:chokidar",
    "start": "electron .",
    "preview": "vite preview",
    "rebuild:electron": "node scripts/rebuild-sqlite-electron.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.2",
    "chokidar": "^4.0.3",
    "classnames": "^2.5.1",
    "mem0ai": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9",
    "cross-env": "^10",
    "electron": "^38",
    "esbuild": "^0.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^9"
  }
}